@page "/admin"
@inject UserService UserService
@inject LineService LineService

<PageTitle>Administration</PageTitle>

<AuthorizeView Roles="@ClientRolesManagement.Administrator">
    <Authorized>
        <div class="admin-container">
            
            <!-- Header section with the create button -->
            <div class="admin-header">
                <h1>User Management</h1>
                <button class="btn btn-primary" @onclick="ShowCreateForm">
                    + Register Worker
                </button>
            </div>

            <!-- Main content split into two panels -->
            <div class="admin-content">
                
                <!-- Left panel: User List -->
                <div class="admin-left-panel">
                    <UserList @ref="_userListRef" OnUserSelected="OnUserSelected" />
                </div>

                <!-- Right panel: User Detail or Create Form -->
                <div class="admin-right-panel">
                    @if (_isCreating)
                    {
                        <CreateUser OnUserCreated="HandleUserCreated" OnCancel="CancelCreate" />
                    }
                    else
                    {
                        <UserDetail UserId="_selectedUserId" 
                                    OnUserUpdated="HandleUserUpdated" 
                                    OnUserDeleted="HandleUserDeleted" />
                    }
                </div>
            </div>
        </div>

        <!-- Modal to assign lines immediately after creation (OUTSIDE the main div) -->
        @if (_isCreatingLinesForNewUser && _newUser != null)
        {
            <ManageLinesModal User="_newUser" 
                              AllLines="_allLines ?? new()" 
                              OnClose="CloseLinesModalForNewUser" 
                              OnSave="HandleLinesSavedForNewUser" />
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger m-4" role="alert">
            You do not have permission to view this page. Only Administrators can access this section.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    // State to track which user is selected in the list
    private Guid? _selectedUserId; 
    
    // Reference to the UserList component to call its methods directly
    private UserList? _userListRef;

    // State to toggle between viewing details and creating a new user
    private bool _isCreating;

    // Variables for the post-creation lines modal
    private UserDetailDto? _newUser;
    private bool _isCreatingLinesForNewUser;
    private List<LineSummaryDto>? _allLines;

    /// <summary>
    /// Handles the selection of a user from the list.
    /// </summary>
    private void OnUserSelected(Guid userId)
    {
        _selectedUserId = userId;
        _isCreating = false; 
    }

    /// <summary>
    /// Shows the form to create a new user.
    /// </summary>
    private void ShowCreateForm()
    {
        _isCreating = true;
        _selectedUserId = null; 
    }

    /// <summary>
    /// Cancels the creation process.
    /// </summary>
    private void CancelCreate()
    {
        _isCreating = false;
    }

    /// <summary>
    /// Triggered when a user is updated or created. Refreshes the list on the left.
    /// </summary>
    private async Task HandleUserUpdated()
    {
        if (_userListRef != null)
        {
            await _userListRef.RefreshAsync();
        }
    }
    /// <summary>
    /// Triggered when a user is deactivated. Refreshes the list and clears the selection.
    /// </summary>
    private async Task HandleUserDeleted()
    {
        _selectedUserId = null;
        await HandleUserUpdated();
    }
    
    /// <summary>
    /// Triggered when a new user is created successfully.
    /// Opens the lines modal if the user is Technician or Operator.
    /// </summary>
    private async Task HandleUserCreated(UserDetailDto createdUser)
    {
        _isCreating = false;

        // If it's a role that needs lines, open the modal
        if (createdUser.Role == "Technician" || createdUser.Role == "Operator")
        {
            if (_allLines == null)
            {
                var linesResult = await LineService.GetLinesAsync();
                if (linesResult.IsSuccess)
                {
                    _allLines = linesResult.Data;
                }
            }

            _newUser = createdUser;
            _isCreatingLinesForNewUser = true;
        }
        else
        {
            // If no lines needed (Admin, PlantManager), refresh the list and finish
            await HandleUserUpdated(); 
        }
    }

    /// <summary>
    /// Closes the lines modal and refreshes the user list.
    /// </summary>
    private async Task CloseLinesModalForNewUser()
    {
        _isCreatingLinesForNewUser = false;
        _newUser = null;
        await HandleUserUpdated();
    }

    /// <summary>
    /// Called when lines are saved for the new user.
    /// </summary>
    private async Task HandleLinesSavedForNewUser()
    {
        _isCreatingLinesForNewUser = false;
        _newUser = null;
        await HandleUserUpdated();
    }
}