@page "/lines"
@attribute [Authorize(Roles = "Administrator")]
@using IndustrialPlanGenerator.Services.Contracts.Lines
@using IndustrialPlanGenerator.Web.Client.Services.LinesManagementService
@implements IDisposable
@inject ILinesManagementService LinesService

<h2 class="page-title">Lines Management</h2>

<div class="split-layout">
    <section class="split-panel">
        <h3 class="page-subtitle">Lines</h3>

        @if (_loadingList)
        {
            <p class="muted">Loading...</p>
        }
        else if (_listError is not null)
        {
            <p class="error">@_listError</p>
        }
        else if (_lines.Count == 0)
        {
            <p class="muted">No lines found.</p>
        }
        else
        {
            <ul>
                @foreach (var line in _lines)
                {
                    <li>
                        <button type="button"
                                class="list-item @(line.Id == _selectedId ? "selected" : "")"
                                @onclick="() => SelectLineAsync(line.Id)">
                            <span class="list-item-content">
                                <span class="list-item-title">@line.Name</span>
                                <span class="list-item-subtitle">@line.ProductiveProcess</span>
                            </span>
                            <span class="list-item-meta" title="Systems">@line.SystemCount</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="split-panel">
        @if (_selectedId is null)
        {
            <p class="muted">Select a line to see its details.</p>
        }
        else if (_loadingDetail)
        {
            <DetailsSkeleton/>
        }
        else if (_detailError is not null)
        {
            <p class="error">@_detailError</p>
        }
        else if (_detail is not null)
        {
            <form class="name-form" @onsubmit="SaveNameAsync">
                <input class="form-control"
                       type="text"
                       aria-label="Line name"
                       maxlength="100"
                       disabled="@_saving"
                       @bind="_editName"
                       @bind:event="oninput"/>
                @if (HasChanges)
                {
                    <button type="submit" class="action-button" disabled="@(!CanSave)">
                        @(_saving ? "Saving..." : "Save")
                    </button>
                }
            </form>

            @if (_saveError is not null)
            {
                <p class="error name-form-error">@_saveError</p>
            }

            <p class="detail-process">@_detail.ProductiveProcess</p>

            <h4>Systems</h4>
            @if (_detail.Systems.Count == 0)
            {
                <p class="muted">This line has no systems.</p>
            }
            else
            {
                <ul>
                    @foreach (var system in _detail.Systems)
                    {
                        <li class="system-item">
                            <div class="system-header">
                                <span class="system-name">@system.Name</span>
                                <span class="system-state">@system.OperativeState</span>
                            </div>
                            <p class="system-description">@system.Description</p>
                        </li>
                    }
                </ul>
            }

            <div class="detail-actions">
                <button type="button" class="action-button danger" @onclick="ShowDeleteConfirmation">
                    Delete line
                </button>

                @if (_deleteError is not null)
                {
                    <p class="error">@_deleteError</p>
                }
            </div>
        }
    </section>
</div>

@if (_confirmingDelete && _detail is not null)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title">
            <h4 id="delete-dialog-title">Delete line</h4>
            <p>Are you sure you want to delete <strong>@_detail.Name</strong>? This action cannot be undone.</p>

            <div class="confirm-actions">
                <button type="button" class="action-button secondary" disabled="@_deleting" @onclick="CancelDelete">
                    Cancel
                </button>
                <button type="button" class="action-button danger" disabled="@_deleting" @onclick="DeleteLineAsync">
                    @(_deleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();

    private List<LineSummaryDto> _lines = [];
    private bool _loadingList = true;
    private string? _listError;

    private Guid? _selectedId;
    private LineDetailDto? _detail;
    private bool _loadingDetail;
    private string? _detailError;

    // Name editing state.
    private string _editName = string.Empty;
    private bool _saving;
    private string? _saveError;

    // Line deletion state.
    private bool _confirmingDelete;
    private bool _deleting;
    private string? _deleteError;

    // True when the text in the input differs from the saved name.
    private bool HasChanges =>
        _detail is not null && _editName.Trim() != _detail.Name;

    // A change can only be saved if it is not blank and no save is in progress.
    private bool CanSave =>
        !_saving && HasChanges && !string.IsNullOrWhiteSpace(_editName);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _lines = [.. await LinesService.LoadLinesAsync(_cts.Token)];
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            _listError = "Could not load the lines.";
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task SelectLineAsync(Guid id)
    {
        _selectedId = id;
        _detail = null;
        _detailError = null;
        _saveError = null;
        _saving = false;
        _deleteError = null;
        _confirmingDelete = false;
        _loadingDetail = true;

        try
        {
            var detail = await LinesService.LoadLineAsync(id, _cts.Token);

            // Ignore the response if the user selected another line while this one was loading.
            if (_selectedId == id)
            {
                _detail = detail;
                _editName = detail.Name;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            if (_selectedId == id)
            {
                _detailError = "Could not load the line details.";
            }
        }
        finally
        {
            if (_selectedId == id)
            {
                _loadingDetail = false;
            }
        }
    }

    private async Task SaveNameAsync()
    {
        if (!CanSave || _detail is null)
        {
            return;
        }

        var id = _detail.Id;
        var newName = _editName.Trim();

        _saving = true;
        _saveError = null;

        try
        {
            // Only the name changes; the productive process is sent back as it is.
            var request = new UpdateLineRequest(newName, _detail.ProductiveProcess);
            var updated = await LinesService.UpdateLineAsync(id, request, _cts.Token);

            // Keep the list in sync, even if the user has selected another line meanwhile.
            var index = _lines.FindIndex(l => l.Id == id);
            if (index >= 0)
            {
                _lines[index] = _lines[index] with { Name = updated.Name };
            }

            if (_selectedId == id)
            {
                _detail = updated;
                _editName = updated.Name;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            if (_selectedId == id)
            {
                _saveError = "Could not save the name.";
            }
        }
        finally
        {
            if (_selectedId == id)
            {
                _saving = false;
            }
        }
    }

    private void ShowDeleteConfirmation()
    {
        _deleteError = null;
        _confirmingDelete = true;
    }

    private void CancelDelete()
    {
        if (!_deleting)
        {
            _confirmingDelete = false;
        }
    }

    private async Task DeleteLineAsync()
    {
        if (_detail is null || _deleting)
        {
            return;
        }

        var id = _detail.Id;

        _deleting = true;
        _deleteError = null;

        try
        {
            var result = await LinesService.DeleteLineAsync(id, _cts.Token);

            switch (result)
            {
                case DeleteLineResult.Deleted:
                case DeleteLineResult.NotFound: // Already deleted elsewhere: the goal is reached.
                    RemoveLine(id);
                    break;

                case DeleteLineResult.HasDependencies:
                    _deleteError = "This line cannot be deleted because it still has associated systems, plans, or assignments.";
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            _deleteError = "Could not delete the line.";
        }
        finally
        {
            _deleting = false;
            _confirmingDelete = false;
        }
    }

    // Removes a line from the list and clears the detail panel if that line was selected.
    private void RemoveLine(Guid id)
    {
        _lines.RemoveAll(l => l.Id == id);

        if (_selectedId == id)
        {
            _selectedId = null;
            _detail = null;
            _editName = string.Empty;
            _saveError = null;
            _deleteError = null;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}