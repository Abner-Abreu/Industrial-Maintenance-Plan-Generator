@page "/login"
@using IndustrialPlanGenerator.Web.Client.Services
@attribute [AllowAnonymous]
@rendermode InteractiveWebAssembly

@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="login-page">
    <section class="login-hero">
        <h1 class="hero-title">Smart maintenance. Uninterrupted production.</h1>
        <p class="hero-subtitle">Centralize your plans, improve team coordination, and make decisions with real-time data.</p>
    </section>

    <section class="login-panel">
        <div class="login-container">
            <p class="login-eyebrow">WELCOME</p>
            <h1 class="login-title">Access your workspace</h1>
            <form @onsubmit="Submit" class="login-form">
                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }

                <div class="login-form-item">
                    <label for="username" class="form-label">User</label>
                    <input id="username" class="form-control" autocomplete="username"
                           @bind="_username" @bind:event="oninput"/>
                </div>

                <div class="login-form-item">
                    <label for="password" class="form-label">Password</label>
                    <input id="password" type="password" class="form-control" autocomplete="current-password"
                           @bind="_password" @bind:event="oninput"/>
                </div>

                <button type="submit" class="login-button">Continue</button>
            </form>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    private async Task Submit()
    {
        if (_loading) return;

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))
        {
            _error = "Introduce user and password.";
            return;
        }

        _error = null;
        _loading = true;

        try
        {
            var ok = await Auth.LoginAsync(new LoginDto
            {
                Username = _username.Trim(),
                Password = _password
            });

            if (ok)
            {
                var returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
                Nav.NavigateTo(returnUrl, replace: true);
            }
            else
            {
                _error = "User or password is incorrect.";
                _password = "";
            }
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't connect to server.";
        }
        finally
        {
            _loading = false;
        }
    }
}