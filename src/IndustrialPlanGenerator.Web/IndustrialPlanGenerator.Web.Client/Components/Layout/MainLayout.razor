@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="app-name">Rivendel</span>
        </div>

        <hr class="sidebar-divider" />

        <nav class="sidebar-nav">
            @foreach (var item in _navItems)
            {
                <NavLink class="nav-item" href="@item.Href" Match="@item.Match">
                    <DynamicComponent Type="item.Icon" Parameters="_iconParams" />
                    <span class="nav-label">@item.Label</span>
                </NavLink>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">@_initials</div>

                <div class="user-info">
                    <span class="user-name">@_userName</span>
                    <span class="user-role">@_userRole</span>
                </div>

                <div class="user-menu-wrapper">
                    <button type="button" class="user-menu-button" aria-label="User menu" @onclick="ToggleMenu">
                        <DynamicComponent Type="typeof(EllipsisVerticalIcon)" Parameters="_iconParams" />
                    </button>

                    @if (_menuOpen)
                    {
                        <div class="user-menu-backdrop" @onclick="CloseMenu"></div>
                        <div class="user-menu">
                            <button type="button" class="user-menu-item" @onclick="CloseSession">
                                <DynamicComponent Type="typeof(LogOutIcon)" Parameters="_iconParams" />
                                <span>Close session</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private record NavItem(string Label, string Href, Type Icon, NavLinkMatch Match = NavLinkMatch.Prefix);

    private readonly Dictionary<string, object> _iconParams = new()
    {
        ["ClassName"] = "nav-icon"
    };

    /// <summary>
    /// each element builds a new nav item at layout
    /// </summary>
    private readonly List<NavItem> _navItems =
    [
        new("Main", "", typeof(HouseIcon), NavLinkMatch.All)
    ];

    private string _userName = "Guest";
    private string _userRole = "";
    private string _initials = "?";
    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true) return;

        _userName = user.Identity.Name ?? "User";
        _userRole = user.FindFirst("role")?.Value ?? "";
        _initials = GetInitials(_userName);
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void CloseSession()
    {
        _menuOpen = false;
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}