@inject UserService UserService

<div class="user-list-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <p>Loading users...</p>
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="error-state">
            <p>@_errorMessage</p>
        </div>
    }
    else if (_groupedUsers == null || !_groupedUsers.Any())
    {
        <div class="empty-state">
            <p>No users found.</p>
        </div>
    }
    else
    {
        <table class="user-table">
            <tbody>
                @foreach (var group in _groupedUsers)
                {
                    <!-- Role Header -->
                    <tr class="role-header-row">
                        <td colspan="2">@group.Key</td>
                    </tr>

                    <!-- Users in this role -->
                    @foreach (var user in group.Value)
                    {
                        var isSelected = _selectedUserId == user.Id;
                        <tr class="user-row @(isSelected ? "selected" : "")" @onclick="() => SelectUser(user.Id)">
                            <td class="user-name">@user.Name</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    // The grouped list of users (Key = Role name)
    private Dictionary<string, List<UserSummaryDto>>? _groupedUsers;
    
    // State to manage loading and error UI
    private bool _isLoading = true;
    private string? _errorMessage;

    // Tracks the currently selected user ID to apply the 'selected' CSS class
    private Guid? _selectedUserId;

    // Event callback to notify the parent component when a user is selected
    [Parameter]
    public EventCallback<Guid> OnUserSelected { get; set; }

    /// <summary>
    /// Loads the user list when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    /// <summary>
    /// Fetches the list of users from the API and groups them by role.
    /// </summary>
    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await UserService.GetUsersAsync();
        
        if (result.IsSuccess && result.Data != null)
        {
            // Group users by Role and order the groups by a custom priority
            var roleOrder = new Dictionary<string, int> {
                { "Administrator", 1 },
                { "PlantManager", 2 },
                { "Technician", 3 },
                { "Operator", 4 }
            };

            _groupedUsers = result.Data.Items
                .GroupBy(u => u.Role)
                .OrderBy(g => roleOrder.TryGetValue(g.Key, out var order) ? order : 99)
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "An unknown error occurred while fetching users.";
        }

        _isLoading = false;
    }

    /// <summary>
    /// Triggers the event to notify the parent component that a user was selected.
    /// Updates the local state to show which row is selected.
    /// </summary>
    /// <param name="userId">The ID of the selected user.</param>
    private async Task SelectUser(Guid userId)
    {
        _selectedUserId = userId;
        await OnUserSelected.InvokeAsync(userId);
    }
}