<div class="user-list-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <p>Loading users...</p>
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="error-state">
            <p>@_errorMessage</p>
        </div>
    }
    else if (_users == null || !_users.Any())
    {
        <div class="empty-state">
            <p>No users found.</p>
        </div>
    }
    else
    {
        <table class="user-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr class="user-row" @onclick="() => SelectUser(user.Id)">
                        <td class="user-name">@user.Name</td>
                        <td>
                            <span class="role-badge role-@user.Role.ToLower()">
                                @user.Role
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    // The list of users retrieved from the API
    private List<UserSummaryDto>? _users;
    
    // State to manage loading and error UI
    private bool _isLoading = true;
    private string? _errorMessage;

    // Event callback to notify the parent component when a user is selected
    [Parameter]
    public EventCallback<Guid> OnUserSelected { get; set; }

    /// <summary>
    /// Loads the user list when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    /// <summary>
    /// Fetches the list of users from the API.
    /// </summary>
    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await UserService.GetUsersAsync();
        
        if (result.IsSuccess && result.Data != null)
        {
            _users = result.Data.Items.ToList();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "An unknown error occurred while fetching users.";
        }

        _isLoading = false;
    }

    /// <summary>
    /// Triggers the event to notify the parent component that a user was selected.
    /// </summary>
    /// <param name="userId">The ID of the selected user.</param>
    private async Task SelectUser(Guid userId)
    {
        await OnUserSelected.InvokeAsync(userId);
    }
}