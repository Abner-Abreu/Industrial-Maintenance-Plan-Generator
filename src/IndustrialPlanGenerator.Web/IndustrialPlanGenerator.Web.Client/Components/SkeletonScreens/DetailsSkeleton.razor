@* Reusable loading placeholder that mimics a detail panel:
   title, subtitle, section heading and a list of items (name + state + description). *@

<div class="detail-skeleton" role="status" aria-busy="true" aria-live="polite">
    <span class="visually-hidden">Loading...</span>

    <div class="skeleton skeleton-title"></div>
    <div class="skeleton skeleton-subtitle"></div>
    <div class="skeleton skeleton-heading"></div>

    @for (var i = 0; i < Rows; i++)
    {
        <div class="skeleton-row" aria-hidden="true">
            <div class="skeleton-row-header">
                <div class="skeleton skeleton-row-name"></div>
                <div class="skeleton skeleton-row-state"></div>
            </div>
            <div class="skeleton skeleton-row-text"></div>
        </div>
    }
</div>

@code {
    /// <summary>Number of placeholder rows shown under the section heading.</summary>
    [Parameter]
    public int Rows { get; set; } = 3;
}